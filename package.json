{
  "name": "n8n-nodes-larvabot",
  "version": "0.1.0",
  "description": "n8n nodes for Larvabot: trigger workflows on new leads, replies and conversations, and read them in any workflow or AI agent.",
  "license": "MIT",
  "homepage": "https://larvabot.com/integrations/n8n",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "larvabot",
    "lead generation",
    "leads",
    "crm",
    "reddit"
  ],
  "author": {
    "name": "Larvabot",
    "email": "hello@larvabot.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karuridavid/n8n-nodes-larvabot.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LarvabotApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Larvabot/Larvabot.node.js",
      "dist/nodes/LarvabotTrigger/LarvabotTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
